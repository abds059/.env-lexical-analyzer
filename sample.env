# ============================================================
#  sample.env Test input for the CT-367 .env Lexer
#  This file deliberately contains all token types including
#  cross-platform risk sites for demonstration purposes.
# ============================================================

# Section 1: Clean, safe assignments 
DB_HOST=localhost
DB_PORT=5432
APP_NAME='My\tApplication'
DESCRIPTION="A production web server"

# Section 2: export keyword usage
export API_KEY=abc123
export DEBUG=false

# Section 3: Quoted values with escape sequences
WELCOME_MSG="Hello\nWelcome to the app"
TAB_EXAMPLE="column1\tcolumn2"
ESCAPED_QUOTE="She said \"hello\""

# Section 4: Inline comments
MAX_RETRIES=3 # maximum connection retries
TIMEOUT=30    # seconds

# Section 5: VAR_EXPANSION risk ${VAR}
BASE_URL=https://api.example.com
FULL_URL=${BASE_URL}/v1/endpoint
COMPOSED=${DB_HOST}:${DB_PORT}

# Section 6: VAR_SHORT risk $VAR
SECRET_KEY=abc$RANDOM_SUFFIX
LOG_PATH=$HOME/logs/app.log

# Section 7: Mixed — safe and risky on same line
CONNECTION=postgresql://${DB_HOST}:${DB_PORT}/mydb
export API_KEY=abc@$$123

# Section 8: Blank lines are valid



# Section 9: Invalid / malformed lines
MISSING_VALUE=
lowercase_key=this_is_invalid
UNCLOSED_SINGLE='not closed
BAD LINE WITH SPACES
